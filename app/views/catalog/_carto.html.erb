<% Geoblacklight.deprecation.warn("The catalog/_carto partial is deprecated and will be removed in GeoBlacklight 5; the Carto OneClick integration is removed without replacement, so remove the :carto show tools partial from your CatalogController") %>
<% document ||= @document %>
<%= link_to Geoblacklight.deprecation.silence { carto_link(document.carto_reference) }, target: '_blank' do %>
  <span class='geoblacklight geoblacklight-carto'></span><%= t('geoblacklight.tools.open_carto') %>
<% end %>
