<%# This template copies from Blacklight's components/document_component.html.erb
      # for the wrapping `content_tag @component` structure
      # and adds custom layout within for the document header, badges and description area %>

<%= content_tag @component,
  id: @id,
  data: {
    'document-id': @document.id.to_s.parameterize,
    'map-id': @document.id.to_s,
    'document-counter': @counter
  },
  itemscope: true,
  itemtype: @document.itemtype,
  class: classes do %>
  <%= header %>
  <%= thumbnail %>
  <div class="document-main-section">
    <%= title %>
    <div class="metadata">
      <%= render Geoblacklight::HeaderBadgesComponent.new(document: @document) %>
      <% if document.description_text.present? %>
        <%= content_tag :p, truncate(document.description_text, length: 250, separator: /\s/), class: "description", itemprop: "description" %>
      <% end %>
    </div>
  </div>
<% end %>
