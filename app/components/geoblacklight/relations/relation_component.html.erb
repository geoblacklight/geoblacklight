<li class="list-group-item">
  <%= link_to document.title, solr_document_path(document) %>
  <%= render Geoblacklight::HeaderBadgesComponent.new(document: document) %>
  <% if document.description_text.present? %>
    <%= content_tag :p, truncate(document.description_text, length: 125, separator: /\s/), class: "description" %>
  <% end %>
  <% if render_sibling_link? %>
    <%= link_to t("geoblacklight.relations.browse.#{browse_label_key}", count: sibling_count), sibling_search_path, class: "browse-all" %>
  <% end %>
</li>
